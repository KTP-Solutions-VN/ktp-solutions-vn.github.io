---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const site = Astro.site ?? new URL('https://www.ktpsolutions.vn');
const pageTitle = `${t('site.name')} — ${t('hero.tagline')}`;
const description = t('site.description');
const keywords = t('site.keywords');

// Canonical + language alternates (one-page site: vi at /, en at /en/)
const canonical = new URL(lang === 'vi' ? '/' : '/en/', site).href;
const alternates = [
  { hreflang: 'vi', href: new URL('/', site).href },
  { hreflang: 'en', href: new URL('/en/', site).href },
  { hreflang: 'x-default', href: new URL('/', site).href },
];

const ogLocale = lang === 'vi' ? 'vi_VN' : 'en_US';
const ogLocaleAlt = lang === 'vi' ? 'en_US' : 'vi_VN';

// Organization structured data (JSON-LD)
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'KTP Solutions',
  url: site.href,
  logo: new URL('/favicon.svg', site).href,
  email: 'info@ktpsolutions.vn',
  description,
  slogan: t('hero.tagline'),
  address: {
    '@type': 'PostalAddress',
    addressCountry: 'VN',
  },
  areaServed: 'VN',
  knowsAbout: [
    'Software Development',
    'Web Design',
    'Web Development',
    'Digital Marketing',
    'Brand Design',
    'Digital Transformation',
  ],
  contactPoint: {
    '@type': 'ContactPoint',
    email: 'info@ktpsolutions.vn',
    contactType: 'customer service',
    availableLanguage: ['Vietnamese', 'English'],
  },
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary -->
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content="KTP Solutions" />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="theme-color" content="#053f31" />

    <!-- Icons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />

    <!-- Canonical + language alternates -->
    <link rel="canonical" href={canonical} />
    {
      alternates.map((a) => (
        <link rel="alternate" hreflang={a.hreflang} href={a.href} />
      ))
    }

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="KTP Solutions" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={ogLocaleAlt} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <!-- Structured data -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify(jsonLd)}
    />
  </head>
  <body>
    <Header lang={lang} />
    <main>
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
