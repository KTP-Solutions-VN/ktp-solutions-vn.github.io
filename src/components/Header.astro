---
import Logo from './Logo.astro';
import { useTranslations, localizedPath } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const nav = [
  { href: '#services', label: t('nav.services') },
  { href: '#about', label: t('nav.about') },
  { href: '#contact', label: t('nav.contact') },
];

const otherLang: Lang = lang === 'vi' ? 'en' : 'vi';
const otherLangPath = localizedPath('/', otherLang);
const home = localizedPath('/', lang);
---

<header
  class="sticky top-0 z-50 border-b border-white/10 bg-navy-950/95 backdrop-blur"
>
  <nav
    class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4"
    aria-label="Main"
  >
    <a href={home} class="flex items-center gap-3" aria-label="KTP Solutions">
      <Logo class="h-7 w-auto text-white sm:h-8" />
    </a>

    <div class="flex items-center gap-6">
      <ul
        class="hidden items-center gap-7 text-sm font-medium text-slate-200 md:flex"
      >
        {
          nav.map((item) => (
            <li>
              <a href={item.href} class="transition hover:text-white">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>

      <a
        href={otherLangPath}
        class="rounded-md border border-white/20 px-3 py-1.5 text-sm font-semibold text-slate-100 transition hover:border-white/60 hover:text-white"
        hreflang={otherLang}
      >
        {otherLang.toUpperCase()}
      </a>

      <a
        href="#contact"
        class="hidden rounded-md bg-brand-500 px-4 py-1.5 text-sm font-semibold text-white transition hover:bg-brand-400 sm:inline-block"
      >
        {t('nav.contact')}
      </a>
    </div>
  </nav>
</header>
