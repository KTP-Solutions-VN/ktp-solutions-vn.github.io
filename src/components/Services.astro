---
import { useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const services = [
  {
    title: t('services.software.title'),
    desc: t('services.software.desc'),
    icon: 'M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4',
  },
  {
    title: t('services.web.title'),
    desc: t('services.web.desc'),
    icon: 'M3 5a2 2 0 012-2h14a2 2 0 012 2v10a2 2 0 01-2 2H5a2 2 0 01-2-2V5zm0 0h18M8 21h8',
  },
  {
    title: t('services.media.title'),
    desc: t('services.media.desc'),
    icon: 'M11 5.882V19.24a1.76 1.76 0 01-3.417.592l-2.147-6.15M18 13a3 3 0 100-6M5.436 13.683A4.001 4.001 0 017 6h1.832c4.1 0 7.625-1.234 9.168-3v14c-1.543-1.766-5.067-3-9.168-3H7a3.988 3.988 0 01-1.564-.317z',
  },
  {
    title: t('services.design.title'),
    desc: t('services.design.desc'),
    icon: 'M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01',
  },
];
---

<section id="services" class="scroll-mt-20 py-24">
  <div class="mx-auto max-w-6xl px-6">
    <div class="text-center">
      <h2 class="text-3xl font-extrabold tracking-tight text-navy-950 sm:text-4xl">
        {t('services.title')}
      </h2>
      <p class="mx-auto mt-4 max-w-xl text-lg text-slate-600">
        {t('services.subtitle')}
      </p>
    </div>

    <div class="mt-16 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        services.map((s) => (
          <article class="group relative overflow-hidden rounded-xl border border-slate-100 bg-white p-8 shadow-sm transition hover:-translate-y-1 hover:border-brand-200 hover:shadow-lg">
            <div class="absolute right-0 top-0 h-16 w-1.5 -skew-x-12 bg-accent-500/0 transition group-hover:bg-accent-500" />
            <div class="flex h-12 w-12 items-center justify-center rounded-lg bg-brand-50 text-brand-600 transition group-hover:bg-brand-600 group-hover:text-white">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-6 w-6"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d={s.icon}
                />
              </svg>
            </div>
            <h3 class="mt-6 text-lg font-bold text-slate-900">{s.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-slate-600">{s.desc}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
